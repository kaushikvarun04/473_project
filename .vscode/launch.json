{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cortex Debug (STM32L4 FreeRTOS)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "objdumpPath": "/usr/bin/arm-none-eabi-objdump",
      "executable": "${workspaceFolder}/build/InverterProject.elf",
      "device": "STM32L432KC",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32l4x.cfg"
      ],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "cwd": "${workspaceFolder}"
    }
  ]
}