{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cortex Debug (STM32L4 FreeRTOS)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/InverterProject.elf",
      "device": "STM32L476RG",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32l4x.cfg"
      ],
      "rtos": "FreeRTOS",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none",
      "cwd": "${workspaceFolder}"
    }
  ]
}