 120:Core/Src/main.c ****     uint8_t is_extended;
 121:Core/Src/main.c ****     uint32_t id;
 122:Core/Src/main.c ****     uint8_t data[8];
 123:Core/Src/main.c **** } CAN_Message;
 124:Core/Src/main.c **** 
 125:Core/Src/main.c **** volatile CAN_Message can_queue[QUEUE_SIZE];
 126:Core/Src/main.c **** volatile int write_index = 0;
 127:Core/Src/main.c **** volatile int read_index = 0;
