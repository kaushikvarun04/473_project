 129:Core/Src/main.c **** void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan) {
 130:Core/Src/main.c ****   CAN_RxHeaderTypeDef rx_header;
 131:Core/Src/main.c ****   uint8_t rx_data[8];
 132:Core/Src/main.c ****   //printf("MAYBE???!\n");
 133:Core/Src/main.c ****   if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &rx_header, rx_data) == HAL_OK) {
 134:Core/Src/main.c ****     // copy data into queue
 135:Core/Src/main.c **** 	  //printf("We are reading a message!\n");
 136:Core/Src/main.c ****     memcpy((void*)can_queue[write_index].data, rx_data, rx_header.DLC);
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****     // check CAN ID format
 139:Core/Src/main.c ****     if (rx_header.IDE == CAN_ID_EXT) {
 140:Core/Src/main.c ****       can_queue[write_index].id = rx_header.ExtId;
 141:Core/Src/main.c ****       can_queue[write_index].is_extended = 1;
 142:Core/Src/main.c ****     }
 143:Core/Src/main.c ****     else {
 144:Core/Src/main.c ****       can_queue[write_index].id = rx_header.StdId;
 145:Core/Src/main.c ****       can_queue[write_index].is_extended = 0;
ARM GAS  /var/folders/4q/0qtsm0qs1wd1vj15jqx7h54m0000gn/T//ccjbSAsF.s 			page 4


 146:Core/Src/main.c ****     }
 147:Core/Src/main.c **** 
 148:Core/Src/main.c ****     // increment ptr
 149:Core/Src/main.c ****     write_index = (write_index + 1) % QUEUE_SIZE;
 150:Core/Src/main.c ****   }
 151:Core/Src/main.c **** }
 152:Core/Src/main.c **** 
 153:Core/Src/main.c **** // CAN data decoder helper function
 154:Core/Src/main.c **** uint64_t extract_bits(uint64_t raw_data, int start, int length) {
 155:Core/Src/main.c ****   // edge case: length = 0
 156:Core/Src/main.c ****   if (length <= 0) return 0;
 157:Core/Src/main.c **** 
 158:Core/Src/main.c ****   // edge case: define behavior for lengths of 64 or greater
 159:Core/Src/main.c ****   if (length >= 64) return raw_data >> start;
 160:Core/Src/main.c **** 
 161:Core/Src/main.c ****   // create bit mask with 64-bit 1
 162:Core/Src/main.c ****   uint64_t mask = (1ULL << length) - 1;
 163:Core/Src/main.c ****   return (raw_data >> start) & mask;
 164:Core/Src/main.c **** }
 165:Core/Src/main.c **** 
 166:Core/Src/main.c **** int32_t extract_signed32(uint64_t raw_data, int start)
 167:Core/Src/main.c **** {
 168:Core/Src/main.c ****     uint32_t value = (uint32_t)extract_bits(raw_data, start, 32);
 169:Core/Src/main.c **** 
 170:Core/Src/main.c ****     if (value & 0x80000000U) {
 171:Core/Src/main.c ****         return -1 - (int32_t)(~value);
 172:Core/Src/main.c ****     }
 173:Core/Src/main.c **** 
 174:Core/Src/main.c ****     return (int32_t)value;
 175:Core/Src/main.c **** }
 176:Core/Src/main.c **** 
 177:Core/Src/main.c **** static float extract_float32(uint64_t raw_data, int start) {
 178:Core/Src/main.c ****   uint32_t bits = (uint32_t)extract_bits(raw_data, start, 32);
 179:Core/Src/main.c ****   float f;
 180:Core/Src/main.c ****   memcpy(&f, &bits, sizeof f);
 181:Core/Src/main.c ****   return f;
 182:Core/Src/main.c **** }
 183:Core/Src/main.c **** 
 184:Core/Src/main.c **** // CAN data decoder for GPS/IMU module
 185:Core/Src/main.c **** double decode_physical_value(uint64_t raw_data, int start, int length, double offset, double scale)
 186:Core/Src/main.c ****   uint64_t raw_value = extract_bits(raw_data, start, length);
 187:Core/Src/main.c ****   return offset + scale * (double) raw_value;
 188:Core/Src/main.c **** }
 189:Core/Src/main.c **** 
 190:Core/Src/main.c **** uint32_t Read_ADC_Value(ADC_HandleTypeDef* hadc, bool convert)
 191:Core/Src/main.c **** {
 192:Core/Src/main.c **** 	//range is 4095 -- 370
 193:Core/Src/main.c ****     uint32_t adc_val = 0;
 194:Core/Src/main.c **** 
 195:Core/Src/main.c ****     // Start the ADC peripheral conversion
 196:Core/Src/main.c ****     HAL_ADC_Start(hadc);
 197:Core/Src/main.c **** 
 198:Core/Src/main.c ****     // Wait for conversion to complete (with a 10ms timeout)
 199:Core/Src/main.c ****     if (HAL_ADC_PollForConversion(hadc, 10) == HAL_OK)
 200:Core/Src/main.c ****     {
 201:Core/Src/main.c ****         // Read the converted value from the data register
 202:Core/Src/main.c ****         adc_val = HAL_ADC_GetValue(hadc);
ARM GAS  /var/folders/4q/0qtsm0qs1wd1vj15jqx7h54m0000gn/T//ccjbSAsF.s 			page 5


 203:Core/Src/main.c ****     }
 204:Core/Src/main.c **** 
 205:Core/Src/main.c ****     // Stop conversion to save power / clean up state
 206:Core/Src/main.c ****     HAL_ADC_Stop(hadc);
 207:Core/Src/main.c ****     if(convert){
 208:Core/Src/main.c ****     // 1. Constrain the input to your known physical sensor limits
 209:Core/Src/main.c **** 	if (adc_val > 4095) adc_val = 4095;
 210:Core/Src/main.c **** 	if (adc_val < 370)  adc_val = 370;
 211:Core/Src/main.c **** 
 212:Core/Src/main.c **** 	// 2. Map the constrained value to a 0 - 100% range
 213:Core/Src/main.c **** 	// Formula: (raw - in_min) * (out_max - out_min) / (in_max - in_min) + out_min
 214:Core/Src/main.c **** 	// Here: (raw_adc - 4095) * (100 - 0) / (370 - 4095) + 0
 215:Core/Src/main.c **** 
 216:Core/Src/main.c **** 	uint32_t throttle_percent = (4095 - adc_val) * 100 / (4095 - 370);
 217:Core/Src/main.c **** 
 218:Core/Src/main.c **** 		return throttle_percent;
 219:Core/Src/main.c ****     }else{
 220:Core/Src/main.c ****     	return adc_val;
 221:Core/Src/main.c ****     }
 222:Core/Src/main.c **** }
 223:Core/Src/main.c **** 
 224:Core/Src/main.c **** float readTempC(int adc) {
 225:Core/Src/main.c ****   float r = R_FIXED * (ADC_MAX - adc)/adc;   // thermistor to ground
 226:Core/Src/main.c ****   float invT = 1.0 / T0 + log(r / R0) / BETA;
 227:Core/Src/main.c ****   float tempC = 1.0 / invT - 273.15;
 228:Core/Src/main.c ****   return tempC * 9.0 / 5.0 + 32.0;
 229:Core/Src/main.c **** 
 230:Core/Src/main.c **** }
