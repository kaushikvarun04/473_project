 111:Core/Src/main.c **** const float R_FIXED = 10000.0;
 112:Core/Src/main.c **** const float R0      = 5000.0;    // from the table at 25 °C
 113:Core/Src/main.c **** const float T0      = 298.15;
 114:Core/Src/main.c **** const float BETA    = 3960.0;    // fit for ~25–85 °C
 115:Core/Src/main.c **** const float ADC_MAX = 4095.0;    // 1023 for 10-bit
 116:Core/Src/main.c **** 
