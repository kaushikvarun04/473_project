7849:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @param  TIM_ExtTRGPrescaler The external Trigger Prescaler.
7850:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *          This parameter can be one of the following values:
7851:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV1: ETRP Prescaler OFF.
7852:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV2: ETRP frequency divided by 2.
7853:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV4: ETRP frequency divided by 4.
7854:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV8: ETRP frequency divided by 8.
7855:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @param  TIM_ExtTRGPolarity The external Trigger Polarity.
7856:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *          This parameter can be one of the following values:
7857:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_INVERTED: active low or falling edge active.
7858:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_NONINVERTED: active high or rising edge active.
7859:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @param  ExtTRGFilter External Trigger Filter.
7860:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   *          This parameter must be a value between 0x00 and 0x0F
7861:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   * @retval None
7862:Drivers/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_tim.c ****   */
